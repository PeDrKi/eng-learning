# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env lên git.

NODE_ENV=development
PORT=3000

# Postgres local (xem docker-compose.yml). Khi deploy: dán connection string của Neon,
# dạng postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://tuvung:tuvung@localhost:5432/tuvung_dev

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Domain FE được phép gọi API (nhiều domain cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173
# URL của FE — dùng dựng link đặt lại mật khẩu trong email
APP_URL=http://localhost:5173

# console = in email ra terminal (khi phát triển) | brevo / resend = gửi qua HTTP API (dùng trên
# Render gói miễn phí — SMTP bị chặn; brevo gửi được bằng Gmail đã xác minh) | smtp = gửi qua SMTP
MAIL_DRIVER=console
# BREVO_API_KEY=xkeysib-xxxxxxxx
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Từ Vựng <no-reply@tenmien.com>"
# Gmail: SMTP_URL=smtps://ban%40gmail.com:MATKHAUUNGDUNG@smtp.gmail.com:465 (mật khẩu ứng dụng 16 ký tự)

# Xác nhận email khi đăng ký: off (mặc định) | required = gửi link, bấm link mới đăng nhập được.
# required cần MAIL_DRIVER thật (smtp/resend/brevo).
# EMAIL_VERIFICATION=off
# EMAIL_VERIFY_TTL_HOURS=24

# Tuỳ chọn (đã có giá trị mặc định hợp lý):
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_MAX_DAYS=90
# PASSWORD_RESET_TTL_MINUTES=60
# Thời gian phản hồi tối thiểu của "quên mật khẩu" (ms) — chống dò email qua độ trễ. 0 = tắt.
# PASSWORD_RESET_MIN_RESPONSE_MS=500
# COOKIE_SAMESITE=lax
# TRUST_PROXY=1
# Header chứa IP thật của người dùng (cho rate limit). Trên Render tự dùng cf-connecting-ip.
# CLIENT_IP_HEADER=cf-connecting-ip

# Hạn mức dữ liệu mỗi tài khoản (chống nhồi dữ liệu làm đầy database). Mặc định như dưới.
# QUOTA_WORDS=20000
# QUOTA_DECKS=500
# QUOTA_PHRASES=5000
# QUOTA_READINGS=500
# QUOTA_GROUPS=50

# ---- Mở rộng (xem SCALING.md). Mặc định hợp với 1 instance, không cần đặt. ----
# Kết nối TRỰC TIẾP cho migration khi DATABASE_URL trỏ qua connection pooler.
# DATABASE_URL_DIRECT=
# Số kết nối DB tối đa của mỗi instance.
# DB_POOL_MAX=10

# Múi giờ để chia "ngày" trong số liệu tổng quan của super admin (GET /admin/overview).
# REPORT_TIME_ZONE=Asia/Ho_Chi_Minh
# Log 1 dòng JSON mỗi request (mặc định bật); request chậm hơn ngưỡng (ms) được đánh dấu slow.
# REQUEST_LOG=true
# SLOW_REQUEST_MS=1000
# Xoá nhật ký ôn tập cũ hơn N ngày khi dọn dẹp định kỳ. 0 = giữ mãi.
# REVIEW_LOG_RETENTION_DAYS=0
