{
  "name": "tuvung-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API cho app Từ Vựng (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "cleanup": "node src/jobs/cleanup.js",
    "reminders": "node src/jobs/sendReminders.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:render": "node src/db/migrate.js && node src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
